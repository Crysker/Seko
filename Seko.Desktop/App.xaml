<Application x:Class="Seko.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!--
            SEKO APP ICON

            Dark alpine / Faroe-inspired mark.
            This gives the running WPF window a proper identity immediately.
            We can replace it with the final generated artwork later when
            packaging the application as a Windows executable.
        -->
        <DrawingImage x:Key="SekoAppIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#14211D">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="32,32"
                                             RadiusX="29"
                                             RadiusY="29" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="{x:Null}">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#315046"
                                 Thickness="2" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="32,32"
                                             RadiusX="25"
                                             RadiusY="25" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="{x:Null}"
                                     Geometry="M 11,43 L 24,25 L 31,34 L 42,19 L 54,43">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#A6CEB8"
                                 Thickness="4"
                                 StartLineCap="Round"
                                 EndLineCap="Round"
                                 LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="{x:Null}"
                                     Geometry="M 16,45 C 25,40 39,40 49,45">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#587565"
                                 Thickness="2"
                                 StartLineCap="Round"
                                 EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>

                    <GeometryDrawing Brush="#D4E8DC">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="42,19"
                                             RadiusX="2.2"
                                             RadiusY="2.2" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!--
            SEKO SCROLLBAR THUMB
        -->
        <Style x:Key="SekoScrollThumbStyle"
               TargetType="{x:Type Thumb}">
            <Setter Property="Background"
                    Value="#30463D" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Margin="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#4B675A" />
                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#719481" />
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ThumbBorder"
                                        Property="Opacity"
                                        Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Vertical scrollbar: thin, quiet, no old-school arrow buttons.
        -->
        <ControlTemplate x:Key="SekoVerticalScrollBarTemplate"
                         TargetType="{x:Type ScrollBar}">
            <Grid Width="10"
                  Background="Transparent">
                <Border Width="6"
                        HorizontalAlignment="Center"
                        Background="#111817"
                        CornerRadius="3" />

                <Track x:Name="PART_Track"
                       Margin="1,3"
                       IsDirectionReversed="True">

                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Focusable="False"
                                      Opacity="0" />
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb MinHeight="34"
                               Style="{StaticResource SekoScrollThumbStyle}" />
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Focusable="False"
                                      Opacity="0" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <!--
            Horizontal scrollbar using the same visual language.
        -->
        <ControlTemplate x:Key="SekoHorizontalScrollBarTemplate"
                         TargetType="{x:Type ScrollBar}">
            <Grid Height="10"
                  Background="Transparent">
                <Border Height="6"
                        VerticalAlignment="Center"
                        Background="#111817"
                        CornerRadius="3" />

                <Track x:Name="PART_Track"
                       Margin="3,1">

                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Focusable="False"
                                      Opacity="0" />
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb MinWidth="34"
                               Style="{StaticResource SekoScrollThumbStyle}" />
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Focusable="False"
                                      Opacity="0" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <!--
            Applies to ScrollViewers throughout Seko.
        -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="Foreground"
                    Value="#30463D" />

            <Setter Property="Width"
                    Value="10" />

            <Setter Property="Template"
                    Value="{StaticResource SekoVerticalScrollBarTemplate}" />

            <Style.Triggers>
                <Trigger Property="Orientation"
                         Value="Horizontal">
                    <Setter Property="Width"
                            Value="Auto" />

                    <Setter Property="Height"
                            Value="10" />

                    <Setter Property="Template"
                            Value="{StaticResource SekoHorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>