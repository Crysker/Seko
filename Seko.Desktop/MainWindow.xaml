<Window x:Class="Seko.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Seko.Desktop.Controls"
        Title="Seko"
        Width="1220"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E0F"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0E0F"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151A1B"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1B2223"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#252D2E"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F3F2"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA4A2"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#65706E"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#91B9A4"/>
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#B7D7C5"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#83C9A3"/>

        <Style x:Key="BaseButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="14,10"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="SidebarButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButton}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="12,10"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>

        </Style>

        <Style x:Key="ActivityListItemStyle"
               TargetType="ListBoxItem">

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="ActivityListItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="11,10">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ActivityListItemBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ActivityListItemBorder"
                                        Property="Background"
                                        Value="#202927"/>

                                <Setter TargetName="ActivityListItemBorder"
                                        Property="BorderBrush"
                                        Value="#40564C"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="StopButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButton}">

            <Setter Property="Foreground"
                    Value="#E2B7B3"/>

            <Setter Property="Background"
                    Value="#241918"/>

            <Setter Property="BorderBrush"
                    Value="#543634"/>

            <Setter Property="Padding"
                    Value="13,7"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

        </Style>

        <Style x:Key="SelectableMessageText"
               TargetType="RichTextBox">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI Variable Text, Segoe UI"/>

            <Setter Property="FontSize"
                    Value="16.5"/>

            <Setter Property="FontWeight"
                    Value="Normal"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="IsReadOnlyCaretVisible"
                    Value="False"/>

            <Setter Property="VerticalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="SelectionBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="SelectionOpacity"
                    Value="0.35"/>

            <Setter Property="Cursor"
                    Value="IBeam"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

        <Style x:Key="SekoContextMenu"
               TargetType="ContextMenu">

            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#34403D"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="4"/>

        </Style>

        <Style x:Key="SekoMenuItem"
               TargetType="MenuItem">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Padding"
                    Value="12,8"/>

        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <Rectangle IsHitTestVisible="False">

            <Rectangle.Fill>

                <RadialGradientBrush
                    Center="0.76,0.05"
                    GradientOrigin="0.76,0.05"
                    RadiusX="0.75"
                    RadiusY="0.8">

                    <GradientStop Color="#173029"
                                  Offset="0"/>

                    <GradientStop Color="#0F1917"
                                  Offset="0.28"/>

                    <GradientStop Color="#0B0E0F"
                                  Offset="0.72"/>

                </RadialGradientBrush>

            </Rectangle.Fill>

        </Rectangle>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->

            <Border Grid.Column="0"
                    Background="#E6101415"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="4,8,4,26">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="34"
                                Height="34"
                                CornerRadius="10">

                            <Border.Background>

                                <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="1,1">

                                    <GradientStop Color="#B7D7C5"
                                                  Offset="0"/>

                                    <GradientStop Color="#56796A"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                            <TextBlock Text="S"
                                       Foreground="#0B0E0F"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="SEKO"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Personal Agent"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>

                            <TextBlock Text="v1.1.4"
                                       FontSize="9"
                                       Foreground="#4F5D59"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Grid>

                    <Button Grid.Row="1"
                            Style="{StaticResource BaseButton}"
                            Margin="0,0,0,22"
                            Click="NewWorkspaceButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="+"
                                       FontSize="17"
                                       Foreground="{StaticResource AccentStrongBrush}"
                                       Margin="0,-1,10,0"/>

                            <TextBlock Text="New workspace"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <StackPanel Grid.Row="2">

                        <TextBlock Text="WORKSPACES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="10,0,0,8"/>

                        <ItemsControl x:Name="WorkspaceList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Style="{StaticResource SidebarButton}"
                                            Margin="0,0,0,3"
                                            Tag="{Binding}"
                                            Click="WorkspaceButton_Click">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="{StaticResource AccentBrush}"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="13"/>

                                        </Grid>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                    <StackPanel Grid.Row="3">

                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="4,0,4,12"/>

                        <Button x:Name="ActivitySidebarButton"
                                Style="{StaticResource SidebarButton}"
                                Click="ActivitySidebarButton_Click">
                            <TextBlock Text="◌   Activity"
                                       FontSize="13"/>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}">
                            <TextBlock Text="◇   Permissions"
                                       FontSize="13"/>
                        </Button>

                        <Button Style="{StaticResource SidebarButton}">
                            <TextBlock Text="⚙   Settings"
                                       FontSize="13"/>
                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- MAIN -->

            <Grid x:Name="ChatView"
                  Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="28,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock x:Name="WorkspaceTitle"
                                       Text="General"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="WorkspacePathText"
                                       Text="Private workspace"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#141A18"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10,6"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse x:Name="AgentStateDot"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource SuccessBrush}"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock x:Name="AgentStateText"
                                           Text="Ready"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

                <!-- CHAT -->

                <ScrollViewer x:Name="ConversationScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Width="720"
                                HorizontalAlignment="Center"
                                Margin="40,65,40,45">

                        <StackPanel Margin="0,0,0,54">

                            <TextBlock Text="Good to see you."
                                       FontSize="31"
                                       FontWeight="Light"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="What are we working on?"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,9,0,0"/>

                        </StackPanel>

                        <ItemsControl x:Name="ConversationList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="0,0,0,30">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30"
                                                Height="30"
                                                CornerRadius="8"
                                                VerticalAlignment="Top"
                                                HorizontalAlignment="Left">

                                            <Border.Background>

                                                <LinearGradientBrush
                                                    StartPoint="0,0"
                                                    EndPoint="1,1">

                                                    <GradientStop Color="#31453D"
                                                                  Offset="0"/>

                                                    <GradientStop Color="#1C2824"
                                                                  Offset="1"/>

                                                </LinearGradientBrush>

                                            </Border.Background>

                                            <TextBlock x:Name="AvatarLetter"
                                                       Text="S"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E7EFEB"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                        </Border>

                                        <StackPanel Grid.Column="1">

                                            <TextBlock x:Name="RoleLabel"
                                                       Text="{Binding Role}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,1,0,8"/>

                                            <controls:MarkdownRichTextBox
                                                MarkdownText="{Binding Content, Mode=OneWay}"
                                                Style="{StaticResource SelectableMessageText}">

                                                <controls:MarkdownRichTextBox.ContextMenu>

                                                    <ContextMenu Style="{StaticResource SekoContextMenu}"
                                                                 DataContext="{Binding PlacementTarget,
                                                                               RelativeSource={RelativeSource Self}}">

                                                        <MenuItem Header="Copy"
                                                                  Style="{StaticResource SekoMenuItem}"
                                                                  Command="{x:Static ApplicationCommands.Copy}"
                                                                  CommandTarget="{Binding}"/>

                                                        <MenuItem Header="Select all"
                                                                  Style="{StaticResource SekoMenuItem}"
                                                                  Command="{x:Static ApplicationCommands.SelectAll}"
                                                                  CommandTarget="{Binding}"/>

                                                    </ContextMenu>

                                                </controls:MarkdownRichTextBox.ContextMenu>

                                            </controls:MarkdownRichTextBox>

                                        </StackPanel>

                                    </Grid>

                                    <DataTemplate.Triggers>

                                        <DataTrigger Binding="{Binding Role}"
                                                     Value="User">

                                            <Setter TargetName="AvatarLetter"
                                                    Property="Text"
                                                    Value="Y"/>

                                            <Setter TargetName="RoleLabel"
                                                    Property="Text"
                                                    Value="You"/>

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding Role}"
                                                     Value="Assistant">

                                            <Setter TargetName="AvatarLetter"
                                                    Property="Text"
                                                    Value="S"/>

                                            <Setter TargetName="RoleLabel"
                                                    Property="Text"
                                                    Value="Seko"/>

                                        </DataTrigger>

                                    </DataTemplate.Triggers>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </ScrollViewer>

                <!-- ACTIVITY + INPUT -->

                <Grid Grid.Row="2"
                      Margin="32,10,32,28">

                    <Grid Width="760"
                          HorizontalAlignment="Center">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- LIVE AGENT ACTIVITY -->

                        <Border x:Name="ActivityPanel"
                                Grid.Row="0"
                                Visibility="Collapsed"
                                Background="#C9141919"
                                BorderBrush="#2B3733"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12"
                                Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,7">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>

                                        <TextBlock x:Name="ActivityHeaderText"
                                                   Text="Working"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentStrongBrush}"/>

                                    </StackPanel>

                                    <ItemsControl x:Name="AgentActivityList">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding}"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="14,1,0,1"/>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                                <Button x:Name="StopAgentButton"
                                        Grid.Column="1"
                                        Content="Stop"
                                        Style="{StaticResource StopButton}"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Top"
                                        Click="StopAgentButton_Click"/>

                            </Grid>

                        </Border>

                        <!-- COMPOSER -->

                        <Border Grid.Row="1"
                                Background="#ED151A1B"
                                BorderBrush="#34403D"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,12">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="AttachmentTray"
                                        Grid.Row="0"
                                        Visibility="Collapsed"
                                        Background="#101615"
                                        BorderBrush="#293431"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="9,7"
                                        Margin="0,0,0,10">

                                    <ItemsControl x:Name="AttachmentList">

                                        <ItemsControl.ItemsPanel>

                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>

                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Border Background="#1B2421"
                                                        BorderBrush="#34433E"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="8,5"
                                                        Margin="0,0,7,4">

                                                    <StackPanel Orientation="Horizontal">

                                                        <TextBlock Text="{Binding KindDisplay}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,7,0"/>

                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   MaxWidth="180"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding FilePath}"
                                                                   VerticalAlignment="Center"/>

                                                        <Button Content="x"
                                                                Tag="{Binding}"
                                                                Style="{StaticResource BaseButton}"
                                                                Width="22"
                                                                Height="22"
                                                                Padding="0"
                                                                Margin="7,0,0,0"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                Click="RemoveAttachmentButton_Click"/>

                                                    </StackPanel>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </Border>

                                <Grid Grid.Row="1">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="AttachFileButton"
                                            Grid.Column="0"
                                            Content="Attach"
                                            Style="{StaticResource BaseButton}"
                                            Padding="10,7"
                                            Margin="0,0,7,0"
                                            HorizontalContentAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Click="AttachFileButton_Click"/>

                                    <Button x:Name="CaptureScreenButton"
                                            Grid.Column="1"
                                            Content="Screen"
                                            Style="{StaticResource BaseButton}"
                                            Padding="10,7"
                                            Margin="0,0,10,0"
                                            HorizontalContentAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Click="CaptureScreenButton_Click"/>

                                    <TextBox x:Name="MessageInput"
                                             Grid.Column="2"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource AccentStrongBrush}"
                                             SelectionBrush="{StaticResource AccentBrush}"
                                             SelectionOpacity="0.35"
                                             FontFamily="Segoe UI Variable Text, Segoe UI"
                                             FontSize="15.5"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MaxHeight="130"
                                             MinHeight="30"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Center"
                                             PreviewKeyDown="MessageInput_PreviewKeyDown"/>

                                    <Button Grid.Column="3"
                                            Width="38"
                                            Height="38"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Bottom"
                                            HorizontalContentAlignment="Center"
                                            Style="{StaticResource BaseButton}"
                                            Background="#28352F"
                                            BorderBrush="#40564C"
                                            Padding="0"
                                            Click="SendButton_Click">

                                        <TextBlock Text="↑"
                                                   FontSize="17"
                                                   Foreground="{StaticResource AccentStrongBrush}"
                                                   HorizontalAlignment="Center"/>

                                    </Button>

                                </Grid>

                            </Grid>

                        </Border>

                        <TextBlock Grid.Row="2"
                                   Text="Enter to send  ·  Shift + Enter for a new line"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                    </Grid>

                </Grid>

            </Grid>

            <!-- PERSISTENT ACTIVITY HISTORY -->

            <Grid x:Name="ActivityHistoryView"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Background="{StaticResource BackgroundBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="28,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Activity"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ActivityHistorySubtitle"
                                       Text="Recent local task history"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button Content="Refresh"
                                    Style="{StaticResource BaseButton}"
                                    Padding="12,7"
                                    Margin="0,0,8,0"
                                    HorizontalContentAlignment="Center"
                                    Click="RefreshActivityHistoryButton_Click"/>

                            <Button Content="Back to chat"
                                    Style="{StaticResource BaseButton}"
                                    Padding="12,7"
                                    HorizontalContentAlignment="Center"
                                    Click="BackToChatButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <Grid Grid.Row="1"
                      Margin="28">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#C9141919"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="RECENT TASKS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="8,5,8,10"/>

                            <ListBox x:Name="ActivityHistoryList"
                                     Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemContainerStyle="{StaticResource ActivityListItemStyle}"
                                     SelectionChanged="ActivityHistoryList_SelectionChanged">

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel>

                                            <Grid Margin="0,0,0,5">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding StartedDisplay}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Status}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Margin="8,0,0,0"/>

                                            </Grid>

                                            <TextBlock Text="{Binding RequestPreview}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="38"
                                                       ToolTip="{Binding RequestPreview}"/>

                                            <TextBlock Text="{Binding WorkspaceDisplay}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,6,0,0"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Grid>

                    </Border>

                    <Border Grid.Column="2"
                            Background="#C9141919"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">

                        <Grid>

                            <TextBlock x:Name="ActivityHistoryEmptyText"
                                       Text="Select a task to inspect its local diagnostic log."
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"/>

                            <ScrollViewer x:Name="ActivityHistoryScrollViewer"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <controls:MarkdownRichTextBox
                                    x:Name="ActivityHistoryDetails"
                                    Style="{StaticResource SelectableMessageText}"
                                    FontSize="13.5"
                                    MarkdownText=""/>

                            </ScrollViewer>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>