<Window x:Class="Seko.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seko"
        Width="1220"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E0F"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#0B0E0F"/>

        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#151A1B"/>

        <SolidColorBrush x:Key="SurfaceHoverBrush"
                         Color="#1B2223"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#252D2E"/>

        <SolidColorBrush x:Key="TextPrimaryBrush"
                         Color="#F1F3F2"/>

        <SolidColorBrush x:Key="TextSecondaryBrush"
                         Color="#9AA4A2"/>

        <SolidColorBrush x:Key="TextMutedBrush"
                         Color="#65706E"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#91B9A4"/>

        <SolidColorBrush x:Key="AccentStrongBrush"
                         Color="#B7D7C5"/>

        <SolidColorBrush x:Key="SuccessBrush"
                         Color="#83C9A3"/>

        <!-- =========================================================
             BUTTONS
             ========================================================= -->

        <Style x:Key="BaseButton"
               TargetType="Button">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="14,10"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SidebarButton"
               TargetType="Button"
               BasedOn="{StaticResource BaseButton}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="12,10"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondaryBrush}"/>

        </Style>

        <!-- =========================================================
             SELECTABLE CHAT TEXT
             ========================================================= -->

        <Style x:Key="SelectableMessageText"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="AcceptsReturn"
                    Value="True"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="IsReadOnlyCaretVisible"
                    Value="False"/>

            <Setter Property="VerticalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="SelectionBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="SelectionOpacity"
                    Value="0.35"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource AccentStrongBrush}"/>

            <Setter Property="Cursor"
                    Value="IBeam"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>

        <!-- =========================================================
             CHAT CONTEXT MENU
             ========================================================= -->

        <Style x:Key="SekoContextMenu"
               TargetType="ContextMenu">

            <Setter Property="Background"
                    Value="{StaticResource SurfaceBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#34403D"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="4"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ContextMenu">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <StackPanel IsItemsHost="True"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SekoMenuItem"
               TargetType="MenuItem">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="MenuItem">

                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter TargetName="MenuItemBorder"
                                        Property="Background"
                                        Value="{StaticResource SurfaceHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextPrimaryBrush}"/>

        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">

        <!-- BACKGROUND ATMOSPHERE -->

        <Rectangle IsHitTestVisible="False">

            <Rectangle.Fill>

                <RadialGradientBrush
                    Center="0.76,0.05"
                    GradientOrigin="0.76,0.05"
                    RadiusX="0.75"
                    RadiusY="0.8">

                    <GradientStop Color="#173029"
                                  Offset="0"/>

                    <GradientStop Color="#0F1917"
                                  Offset="0.28"/>

                    <GradientStop Color="#0B0E0F"
                                  Offset="0.72"/>

                </RadialGradientBrush>

            </Rectangle.Fill>

        </Rectangle>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =====================================================
                 SIDEBAR
                 ===================================================== -->

            <Border Grid.Column="0"
                    Background="#E6101415"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- SEKO BRAND -->

                    <Grid Grid.Row="0"
                          Margin="4,8,4,26">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="34"
                                Height="34"
                                CornerRadius="10">

                            <Border.Background>

                                <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="1,1">

                                    <GradientStop Color="#B7D7C5"
                                                  Offset="0"/>

                                    <GradientStop Color="#56796A"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                            <TextBlock Text="S"
                                       Foreground="#0B0E0F"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="SEKO"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Personal Agent"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                    </Grid>

                    <!-- NEW WORKSPACE -->

                    <Button Grid.Row="1"
                            Style="{StaticResource BaseButton}"
                            Margin="0,0,0,22"
                            Click="NewWorkspaceButton_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="+"
                                       FontSize="17"
                                       Foreground="{StaticResource AccentStrongBrush}"
                                       Margin="0,-1,10,0"/>

                            <TextBlock Text="New workspace"
                                       FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <!-- WORKSPACES -->

                    <StackPanel Grid.Row="2">

                        <TextBlock Text="WORKSPACES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="10,0,0,8"/>

                        <ItemsControl x:Name="WorkspaceList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Style="{StaticResource SidebarButton}"
                                            Margin="0,0,0,3"
                                            Tag="{Binding}"
                                            Click="WorkspaceButton_Click">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="{StaticResource AccentBrush}"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13"/>

                                        </Grid>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                    <!-- FOOTER -->

                    <StackPanel Grid.Row="3">

                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="4,0,4,12"/>

                        <Button Style="{StaticResource SidebarButton}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="◌"
                                           Margin="0,0,10,0"
                                           Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock Text="Activity"
                                           FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <Button Style="{StaticResource SidebarButton}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="◇"
                                           Margin="0,0,10,0"
                                           Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock Text="Permissions"
                                           FontSize="13"/>

                            </StackPanel>

                        </Button>

                        <Button Style="{StaticResource SidebarButton}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="⚙"
                                           Margin="0,0,10,0"
                                           Foreground="{StaticResource TextMutedBrush}"/>

                                <TextBlock Text="Settings"
                                           FontSize="13"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- =====================================================
                 MAIN CONTENT
                 ===================================================== -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <Border Grid.Row="0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="28,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock x:Name="WorkspaceTitle"
                                       Text="General"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="WorkspacePathText"
                                       Text="Private workspace"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>

                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#141A18"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10,6"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{StaticResource SuccessBrush}"
                                         Margin="0,0,7,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text="Ready"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

                <!-- =================================================
                     CONVERSATION
                     ================================================= -->

                <ScrollViewer x:Name="ConversationScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>

                        <StackPanel Width="720"
                                    HorizontalAlignment="Center"
                                    Margin="40,65,40,45">

                            <!-- INTRO -->

                            <StackPanel Margin="0,0,0,54">

                                <TextBlock Text="Good to see you."
                                           FontSize="31"
                                           FontWeight="Light"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="What are we working on?"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,9,0,0"/>

                            </StackPanel>

                            <!-- CHAT -->

                            <ItemsControl x:Name="ConversationList">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,0,0,26">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- AVATAR -->

                                            <Border Width="28"
                                                    Height="28"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Top"
                                                    HorizontalAlignment="Left">

                                                <Border.Background>

                                                    <LinearGradientBrush
                                                        StartPoint="0,0"
                                                        EndPoint="1,1">

                                                        <GradientStop Color="#31453D"
                                                                      Offset="0"/>

                                                        <GradientStop Color="#1C2824"
                                                                      Offset="1"/>

                                                    </LinearGradientBrush>

                                                </Border.Background>

                                                <TextBlock x:Name="AvatarLetter"
                                                           Text="S"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                            </Border>

                                            <!-- MESSAGE -->

                                            <StackPanel Grid.Column="1">

                                                <TextBlock x:Name="RoleLabel"
                                                           Text="{Binding Role}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="0,2,0,7"/>

                                                <!--
                                                    This looks like normal chat text,
                                                    but it is actually a read-only
                                                    TextBox.

                                                    That means:
                                                    - drag to select
                                                    - Ctrl+C
                                                    - Ctrl+A
                                                    - right-click Copy
                                                -->

                                                <TextBox Text="{Binding Content, Mode=OneWay}"
                                                         Style="{StaticResource SelectableMessageText}">

                                                    <TextBox.ContextMenu>

                                                        <ContextMenu
                                                            Style="{StaticResource SekoContextMenu}"
                                                            DataContext="{Binding PlacementTarget,
                                                                          RelativeSource={RelativeSource Self}}">

                                                            <MenuItem Header="Copy"
                                                                      Style="{StaticResource SekoMenuItem}"
                                                                      Command="{x:Static ApplicationCommands.Copy}"
                                                                      CommandTarget="{Binding}"/>

                                                            <MenuItem Header="Select all"
                                                                      Style="{StaticResource SekoMenuItem}"
                                                                      Command="{x:Static ApplicationCommands.SelectAll}"
                                                                      CommandTarget="{Binding}"/>

                                                        </ContextMenu>

                                                    </TextBox.ContextMenu>

                                                </TextBox>

                                            </StackPanel>

                                        </Grid>

                                        <DataTemplate.Triggers>

                                            <DataTrigger Binding="{Binding Role}"
                                                         Value="User">

                                                <Setter TargetName="AvatarLetter"
                                                        Property="Text"
                                                        Value="Y"/>

                                                <Setter TargetName="RoleLabel"
                                                        Property="Text"
                                                        Value="You"/>

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Role}"
                                                         Value="Assistant">

                                                <Setter TargetName="AvatarLetter"
                                                        Property="Text"
                                                        Value="S"/>

                                                <Setter TargetName="RoleLabel"
                                                        Property="Text"
                                                        Value="Seko"/>

                                            </DataTrigger>

                                        </DataTemplate.Triggers>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Grid>

                </ScrollViewer>

                <!-- =================================================
                     MESSAGE INPUT
                     ================================================= -->

                <Grid Grid.Row="2"
                      Margin="32,10,32,28">

                    <Grid Width="760"
                          HorizontalAlignment="Center">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#ED151A1B"
                                BorderBrush="#34403D"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18,13">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="MessageInput"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource AccentStrongBrush}"
                                         SelectionBrush="{StaticResource AccentBrush}"
                                         SelectionOpacity="0.35"
                                         FontSize="14"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MaxHeight="130"
                                         MinHeight="30"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Center"
                                         PreviewKeyDown="MessageInput_PreviewKeyDown"/>

                                <Button Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Bottom"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource BaseButton}"
                                        Background="#28352F"
                                        BorderBrush="#40564C"
                                        Padding="0"
                                        Click="SendButton_Click">

                                    <TextBlock Text="↑"
                                               FontSize="17"
                                               Foreground="{StaticResource AccentStrongBrush}"
                                               HorizontalAlignment="Center"/>

                                </Button>

                            </Grid>

                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="Enter to send  ·  Shift + Enter for a new line"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                    </Grid>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</Window>