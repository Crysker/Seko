<Window x:Class="Seko.UI.Views.AgentMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/2003/xaml/namespace"
        Title="Agent Monitor" Height="300" Width="400">
    <Grid>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Agent is idle."/>
        <Button x:Name="StopButton" Content="Stop Agent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,0" Click="StopButton_Click"/>
    </Grid>
</Window>